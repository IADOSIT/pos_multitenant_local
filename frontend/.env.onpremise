# Build de la instalacion en sitio (npm run build -> dist-prod).
# vite build --mode onpremise NO lee .env.production, por eso se repite VITE_API_URL.
# La nube (dist-vps) se compila sin --mode y nunca lee este archivo.
VITE_API_URL=/api
VITE_SOCKET_MISMO_ORIGEN=1
# El servidor es local: no creerle a navigator.onLine (sin router dice false).
VITE_EN_SITIO=1
