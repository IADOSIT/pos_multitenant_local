# URL del backend del POS (VPS o local)
BACKEND_URL=https://posapi.iados.online

# Token de la tienda — copiar desde POS -> Configuracion -> Bascula de autoservicio
TIENDA_TOKEN=paste-your-tienda-token-here

# Puerto serial donde esta conectada la bascula (ver Administrador de dispositivos
# de Windows -> Puertos COM). Ejemplo: COM3
SCALE_PORT=COM3

# Velocidad del puerto serial de la bascula (ver manual del fabricante, comun 9600).
# En basculas por USB con puerto COM virtual (CDC) este valor es irrelevante.
SCALE_BAUD=9600

# Basculas de polling: no transmiten solas, hay que pedirles el peso cada tanto.
#   SCALE_POLL_MS=0    -> bascula de flujo continuo (emite sola). Es el default.
#   SCALE_POLL_MS=400  -> pregunta cada 400ms. Torrey por USB requiere esto.
# SCALE_POLL_CMD acepta los escapes \r y \n. Comando tipico de Torrey: P\r\n
SCALE_POLL_CMD=P\r\n
SCALE_POLL_MS=0
