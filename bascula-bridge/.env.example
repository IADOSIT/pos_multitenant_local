# URL del backend del POS (VPS o local)
BACKEND_URL=https://posapi.iados.online

# Token de la tienda — copiar desde POS -> Configuracion -> Bascula de autoservicio
TIENDA_TOKEN=paste-your-tienda-token-here

# Puerto serial donde esta conectada la bascula (ver Administrador de dispositivos
# de Windows -> Puertos COM). Ejemplo: COM3
SCALE_PORT=COM3

# Velocidad del puerto serial de la bascula (ver manual del fabricante, comun 9600)
SCALE_BAUD=9600
