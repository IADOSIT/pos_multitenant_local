{
  "name": "pos-iados-bascula-bridge",
  "version": "1.6.0",
  "description": "Bridge local de POS-iaDoS: bascula, impresora de etiquetas (red o USB) y cajon de dinero, con estacion nombrada para tiendas con varias basculas, con puente en 127.0.0.1 para operar sin internet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "mx.iados.bascula-bridge",
    "productName": "POS-iaDoS Bridge Bascula",
    "win": {
      "target": ["nsis", "zip"],
      "requestedExecutionLevel": "asInvoker",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "installerLanguages": ["en_US"],
      "shortcutName": "POS-iaDoS Bridge Bascula",
      "include": "installer.nsh",
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "POS-iaDoS-Bridge-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "config.html",
      "package.json",
      "icon.ico"
    ]
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  }
}
