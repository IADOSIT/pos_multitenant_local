node_modules/
# shop/.next/standalone incluye su propio node_modules recortado (necesario para
# Docker: el Dockerfile del shop NO corre npm install, solo copia standalone/)
!shop/.next/standalone/node_modules/
!shop/.next/standalone/node_modules/**
build/
# dist/ excluido globalmente EXCEPTO backend/dist y frontend/dist-prod (necesarios para Docker)
dist/
!backend/dist/
!backend/dist/**
!frontend/dist-prod/
!frontend/dist-prod/**
!frontend/dist-vps/
!frontend/dist-vps/**
.env
.env.local
*.log
.DS_Store
Thumbs.db
coverage/
.nyc_output/
*.tsbuildinfo
.claude/settings.local.json
